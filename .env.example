# Databricks CLI Configuration (Template)
# Preencha com os valores do seu ambiente e copie para .env
DATABRICKS_PROFILE=seu_perfil_cli
DATABRICKS_HOST=https://<seu-workspace-id>.cloud.databricks.com
DATABRICKS_WORKSPACE_DIR=/Workspace/<nome_do_projeto>
DATABRICKS_JOB_ID=<seu_job_id>
DATABRICKS_LANDING_VOLUME=/Volumes/<catalogo>/<schema>/<volume>/landing
